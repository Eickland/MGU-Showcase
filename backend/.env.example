# Хранилище: postgres | memory (memory — без БД, данные из SEED_FILE, теряются при перезапуске)
STORAGE=postgres
DATABASE_URL=postgres://mgu:mgu@localhost:5432/mgu?sslmode=disable
MIGRATE_ON_START=true
SEED_FILE=seed/services.json

PORT=8081
# Bearer-токен для POST/PATCH/DELETE и ?scope=all. Не короче 16 символов. Пусто — запись выключена.
ADMIN_TOKEN=2rg213r987231yhrf98237yr7214
# Только для разработки: доверять заголовкам X-Dev-User / X-Dev-Roles
AUTH_DEV_HEADERS=false
CORS_ALLOWED_ORIGINS=http://localhost:20127

LOG_LEVEL=info
LOG_FORMAT=text
